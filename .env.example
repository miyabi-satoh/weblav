# このファイルは sqlx-cli (`cargo sqlx migrate add` 等) と `sqlx::query!` マクロの
# コンパイル時チェック専用。実行時の設定は config.toml で行う (config.example.toml 参照)。
# DB は `just dev-backend` が使うもの (WEBLAV_HOME=data/dev-runtime) と共用する。
#
#   cp .env.example .env
#   mkdir -p data/dev-runtime && cargo sqlx database setup
DATABASE_URL=sqlite://data/dev-runtime/weblav.db
