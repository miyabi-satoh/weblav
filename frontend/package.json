{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@11.3.0",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"test:e2e": "playwright install && playwright test",
		"generate:api-types": "openapi-typescript ../openapi.json -o src/lib/api/schema.d.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource/biz-udpgothic": "^5.3.0",
		"@inlang/paraglide-js": "^2.25.4",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.48.0",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.2",
		"@types/qrcode": "^1.5.6",
		"@vitest/browser-playwright": "^5.0.1",
		"bits-ui": "^2.19.3",
		"cheerio": "^1.2.0",
		"clsx": "^2.1.1",
		"concurrently": "^10.0.5",
		"core-js": "3.50.0",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"mode-watcher": "^1.1.0",
		"openapi-typescript": "^7.13.0",
		"playwright": "^1.63.0",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"shadcn-svelte": "^1.7.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"svelte-dnd-action": "^0.9.79",
		"svelte-sonner": "^1.2.1",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.1",
		"vite": "^8.3.1",
		"vitest": "^5.0.1",
		"vitest-browser-svelte": "^3.1.0"
	},
	"dependencies": {
		"@silurus/ooxml": "0.88.0",
		"dompurify": "^3.4.16",
		"highlight.js": "11.12.0",
		"marked": "^18.0.14",
		"openapi-fetch": "^0.17.0",
		"pdfjs-dist": "6.3.289",
		"photoswipe": "5.4.4",
		"qrcode": "^1.5.4"
	}
}
